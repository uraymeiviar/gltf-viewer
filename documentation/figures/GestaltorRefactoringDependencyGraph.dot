digraph "Gestaltor" {
	fontname="Helvetica,Arial,sans-serif"
	node [fontname="Helvetica,Arial,sans-serif" fontsize = "12"]
	edge [fontname="Helvetica,Arial,sans-serif" ]

  subgraph cluster_0 {
    label = "GUI";

    "Gestaltor" [  shape = egg ];
    "UI Model" [ shape = doubleoctagon ];
    "Mementos" [ shape = pentagon ];
  }

  subgraph cluster_1 {
    label = "Business Logic";
    
    "Operations" [ shape = doubleoctagon ];
    "Reactor" [ label = "Reactor", shape = doubleoctagon ];
    "Datastorage" [ shape = doubleoctagon ];
    "gltf-schema" [ label = "gltf-schema", shape = pentagon ];
  }
  
  subgraph cluster_2 {
    label = "Rendering";
    "3D Viewer" [  shape = doubleoctagon ];
  }

  subgraph cluster_common {
    label = "Common";
    "Math" [ shape = doubleoctagon ];
  }


  "Gestaltor" -> "UI Model" [ style = dotted ]
    
  "3D Viewer" -> "Math" 
  
  "UI Model" -> "3D Viewer" [ style = dotted ]

  "UI Model" -> "Mementos" [ style = dotted ]
  "UI Model" -> "Operations" [ style = dotted ]
  "UI Model" -> "Reactor" [ style = dotted ]

  "Operations" -> "Datastorage" 
  "Operations" -> "Reactor" [ style = dotted ]
  
  "Reactor" -> "Math" [style = dotted]
  "Reactor" -> "Datastorage"

  "Operations" -> "gltf-schema" [ style = dotted ]
  "Reactor" -> "gltf-schema" [ style = dotted ]
}
