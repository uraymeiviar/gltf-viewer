<?xml version="1.0" encoding="UTF-8"?>
<Installer>
    <Name>${UX3D_PROJECT_NAME}</Name>
    <Version>${UX3D_VERSION}</Version>
    <Title>${UX3D_PROJECT_NAME}</Title>
    <Publisher>UX3D GmbH</Publisher>
    <!-- Directory name is used in installscript.qs -->
