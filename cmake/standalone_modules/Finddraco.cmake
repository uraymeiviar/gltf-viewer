if (TARGET draco::draco OR TARGET draco)
    set(draco_FOUND TRUE)
    set(DRACO_FOUND TRUE)
    if (NOT TARGET draco::draco AND TARGET draco)
        add_library(draco::draco ALIAS draco)
    endif()
    if (DEFINED draco_SOURCE_DIR)
        set(draco_INCLUDE_DIRS "${draco_SOURCE_DIR}/src" "${draco_BINARY_DIR}" "${CMAKE_BINARY_DIR}")
    else()
        set(draco_INCLUDE_DIRS "${CMAKE_BINARY_DIR}")
    endif()
    return()
endif()
